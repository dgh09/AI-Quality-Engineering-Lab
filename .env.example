# Plantilla de configuración. Copiar a .env y ajustar; el .env real nunca se commitea.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
GENERATOR_MODEL=qwen2.5:3b
JUDGE_MODEL=qwen2.5:3b

# Umbrales y parámetros de evaluación (valores por defecto de config.py).
# Distancia coseno máxima para que un chunk entre al contexto (calibrado en T8).
RELEVANCE_THRESHOLD=0.6
TOP_K=3
RUNS_PER_CASE=3
PASS_RATE_THRESHOLD=0.67
